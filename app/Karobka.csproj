<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF faqat kod orqali (XAML ish vaqtida XamlReader bilan yuklanadi), shuning uchun
       Linux'da ham yig'iladi: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Karobka</AssemblyName>
    <RootNamespace>Karobka</RootNamespace>
    <Version>2.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <EmbeddedResource Include="UI\Main.xaml" LogicalName="Main.xaml" />
    <Compile Remove="tests\**" />
  </ItemGroup>
</Project>
