<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karobka" Width="980" Height="620" MinWidth="860" MinHeight="520"
        Background="#F2F2F4" FontFamily="Segoe UI" FontSize="12" Foreground="#1C1C1E"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Dizayn tizimi: ranglar, radius, balandliklar shu yerda -->
    <SolidColorBrush x:Key="Bg" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Field" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="FieldHover" Color="#E8E8EC"/>
    <SolidColorBrush x:Key="Line" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Text" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Accent" Color="#1C1C1E"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.06"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <!-- Kiritish maydoni: chegara yo'q, foni Field -->
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
    </Style>

    <!-- -/+ tugmasi -->
    <Style x:Key="Step" TargetType="RepeatButton">
      <Setter Property="Width" Value="36"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Delay" Value="350"/>
      <Setter Property="Interval" Value="60"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource FieldHover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Asosiy amal tugmasi -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="12" Padding="20,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3A3A3C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Yoyilma | 3D almashtirgichi -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="72"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Shablon -->
    <Border Style="{StaticResource Card}" Grid.Column="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Shablon" Style="{StaticResource Title}"/>
        <Border DockPanel.Dock="Top" Background="{StaticResource Field}" CornerRadius="10" Height="34" Margin="0,0,0,12">
          <Grid Margin="12,0">
            <TextBlock x:Name="SearchHint" Text="Qidirish" Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="Search" Style="{StaticResource FieldBox}" FontWeight="Normal" FontSize="12"/>
          </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TemplateList"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- O'lcham -->
    <Border Style="{StaticResource Card}" Grid.Column="2">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="O'lcham" Style="{StaticResource Title}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Fields"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ko'rinish -->
    <Border Style="{StaticResource Card}" Grid.Column="4">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <TextBlock x:Name="PreviewTitle" Style="{StaticResource Title}" Margin="0" VerticalAlignment="Center"/>
          <Border Background="{StaticResource Field}" CornerRadius="10" Padding="3" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeFlat" Content="Yoyilma" GroupName="mode" Style="{StaticResource Seg}" IsChecked="True"/>
              <RadioButton x:Name="Mode3D" Content="3D" GroupName="mode" Style="{StaticResource Seg}"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="PreviewHost" Background="White" ClipToBounds="True">
          <Viewbox x:Name="FlatBox" Stretch="Uniform" Margin="8">
            <Canvas x:Name="Flat"/>
          </Viewbox>
          <Grid x:Name="View3DHost" Visibility="Collapsed" Background="Transparent" Cursor="SizeAll"
                ToolTip="Sichqoncha bilan aylantiring, g'ildirak bilan yaqinlashtiring">
            <Viewport3D x:Name="View3D"/>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Pastki qator -->
    <Grid Grid.Row="2" Grid.ColumnSpan="5">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="14" Height="2" Background="#2F6BFF" VerticalAlignment="Center"/>
        <TextBlock Text="Kesish" Style="{StaticResource Unit}" Margin="6,0,16,0" VerticalAlignment="Center"/>
        <Border Width="14" Height="2" Background="#E5484D" VerticalAlignment="Center"/>
        <TextBlock Text="Bukish" Style="{StaticResource Unit}" Margin="6,0,24,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="Status" Style="{StaticResource Unit}" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="DrawBtn" Content="Chizish" Style="{StaticResource Primary}" HorizontalAlignment="Right"
              ToolTip="Ochiq CorelDRAW hujjatiga chizadi"/>
    </Grid>
  </Grid>
</Window>
